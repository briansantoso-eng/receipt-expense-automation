# Copy this file to ".env" (same folder) and replace every placeholder with a
# real value. Never commit the real .env file to GitHub — .gitignore should
# exclude it.

# From platform.claude.com. Add billing/credits to the account first, or every
# call comes back as a 400.
ANTHROPIC_API_KEY=sk-ant-your-actual-key-here

# The inbox clients send their submissions to.
GMAIL_ADDRESS=you@gmail.com

# NOT your Google account password. Generate a 16-character app password at
# myaccount.google.com/apppasswords (requires 2-Step Verification to be on).
# Paste it with or without spaces — both work.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional. Where the review drafts get sent. Defaults to GMAIL_ADDRESS.
REVIEW_EMAIL=you@gmail.com
